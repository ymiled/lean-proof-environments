-- PROOF lem_a681
  induction c with
  | cusp => intro s t _ h; exact h
  | root x e =>
    intro s t hw h z hz
    simp [graft] at hw
    by_cases hzx : z = x
    · subst hzx
      rw [hz] at hw
      simp at hw
      simp [clasp]
      exact lem_fcb6 G s t e hw h
    · simp [clasp, hzx]
      exact h z hz
  | flint c d ihc ihd =>
    intro s t hw h
    simp [graft, Bool.and_eq_true] at hw
    exact ihd (hew s c) (hew t c) hw.2 (ihc s t hw.1 h)
  | base e c d ihc ihd =>
    intro s t hw h
    simp [graft, Bool.and_eq_true] at hw
    by_cases hfe : fuse G e = true
    · rw [hfe] at hw
      obtain ⟨hwc, hwd⟩ := hw
      have hcs : twine G s (hew s c) := lem_7ce1 G c s hwc
      have hct : twine G t (hew t c) := lem_7ce1 G c t hwc
      have hds : twine G s (hew s d) := lem_7ce1 G d s hwd
      have hdt : twine G t (hew t d) := lem_7ce1 G d t hwd
      by_cases hs0 : weave s e = 0 <;> by_cases ht0 : weave t e = 0 <;>
        simp [hew, hs0, ht0] <;>
        first
          | exact lem_0095 G _ _ _ (lem_0095 G _ _ _ (lem_cc32 G _ _ hds) h) hdt
          | exact lem_0095 G _ _ _ (lem_0095 G _ _ _ (lem_cc32 G _ _ hcs) h) hct
          | exact lem_0095 G _ _ _ (lem_0095 G _ _ _ (lem_cc32 G _ _ hds) h) hct
          | exact lem_0095 G _ _ _ (lem_0095 G _ _ _ (lem_cc32 G _ _ hcs) h) hdt
    · have hfe' : fuse G e = false := by
        cases h2 : fuse G e
        · exact h2
        · exact absurd h2 hfe
      rw [hfe'] at hw
      obtain ⟨hwc, hwd⟩ := hw
      have heq : weave s e = weave t e := lem_fcb6 G s t e hfe' h
      by_cases hs0 : weave s e = 0
      · have ht0 : weave t e = 0 := by rw [← heq]; exact hs0
        simp [hew, hs0, ht0]
        exact ihd s t hwd h
      · have ht0 : weave t e ≠ 0 := by rw [← heq]; exact hs0
        simp [hew, hs0, ht0]
        exact ihc s t hwc h
