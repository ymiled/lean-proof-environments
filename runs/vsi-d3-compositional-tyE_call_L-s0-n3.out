-- PROOF tyE_call_L
  suffices H : ∀ e t', TyE G sg e t' → e = .call f a → t' = .base .L →
      sg f = some (.L, .L) ∧ TyE G sg a (.base .L) by
    exact H _ _ h rfl rfl
  intro e t' hty
  induction hty with
  | evar | int | binop => intro he ht; cases he
  | call hf hte _ => intro he ht; cases he; cases ht; exact ⟨hf, hte⟩
  | sub hty hsub ih =>
    intro he ht
    subst ht
    obtain ⟨a', ha', hab⟩ := sub_base_inv hsub
    cases a' with
    | L => exact ih he ha'
    | H => exact absurd hab (by decide)
