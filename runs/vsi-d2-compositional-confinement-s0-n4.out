-- PROOF confinement
  intro k
  induction k with
  | zero =>
      intro c ty _ _ s s' he
      simp [evalC] at he
  | succ k ih =>
      intro c ty hty
      induction hty with
      | skip =>
          intro _ s s' he
          simp only [evalC, Option.some.injEq] at he
          subst he
          exact lowEq_refl G s
      | assign x e t hxt hte =>
          intro hsec s s' he
          simp only [evalC, Option.bind_eq_some] at he
          obtain ⟨v, _hv, he2⟩ := he
          simp only [Option.some.injEq] at he2
          subst he2
          have ht : t = Lvl.H := hsec
          intro y hy
          by_cases hxy : y = x
          · exfalso
            subst hxy
            rw [hxt, ht] at hy
            injection hy with hy'
            cases hy'
          · simp [upd, hxy]
      | iteHH e c d hcond hc hd ihc ihd =>
          intro hsec s s' he
          simp only [evalC, Option.bind_eq_some] at he
          obtain ⟨v, _hv, he2⟩ := he
          by_cases hv0 : v = 0
          · rw [if_pos hv0] at he2
            exact ihd hsec s s' he2
          · rw [if_neg hv0] at he2
            exact ihc hsec s s' he2
      | iteL e c d a b hcond hc hd ihc ihd =>
          intro hsec s s' he
          simp only [evalC, Option.bind_eq_some] at he
          obtain ⟨v, _hv, he2⟩ := he
          by_cases hv0 : v = 0
          · rw [if_pos hv0] at he2
            exact ihd hsec s s' he2
          · rw [if_neg hv0] at he2
            exact ihc hsec s s' he2
      | iteN e c d t n hcond hc hd ihc ihd =>
          intro hsec s s' he
          have hsec' : secure (Ty.ncmd t n) := hsec
          simp only [evalC, Option.bind_eq_some] at he
          obtain ⟨v, _hv, he2⟩ := he
          by_cases hv0 : v = 0
          · rw [if_pos hv0] at he2
            exact ihd hsec' s s' he2
          · rw [if_neg hv0] at he2
            exact ihc hsec' s s' he2
      | whHH e c hcond hbody ihbody =>
          intro hsec s s' he
          simp only [evalC, Option.bind_eq_some] at he
          obtain ⟨v, _hv, he2⟩ := he
          by_cases hv0 : v = 0
          · rw [if_pos hv0] at he2
            simp only [Option.some.injEq] at he2
            subst he2
            exact lowEq_refl G s
          · rw [if_neg hv0] at he2
            simp only [Option.bind_eq_some] at he2
            obtain ⟨s1, he3, he4⟩ := he2
            have hlow1 : lowEq G s s1 := ihbody hsec s s1 he3
            have hty' : TyC G sg (Com.wh e c) (Ty.cmd Lvl.H Lvl.H) := TyC.whHH hcond hbody
            have hsec' : secure (Ty.cmd Lvl.H Lvl.H) := rfl
            have hlow2 : lowEq G s1 s' := ih (Com.wh e c) (Ty.cmd Lvl.H Lvl.H) hty' hsec' s1 s' he4
            exact lowEq_trans hlow1 hlow2
      | whL e c a b hcond hbody hab ihbody =>
          intro hsec s s' he
          simp only [evalC, Option.bind_eq_some] at he
          obtain ⟨v, _hv, he2⟩ := he
          by_cases hv0 : v = 0
          · rw [if_pos hv0] at he2
            simp only [Option.some.injEq] at he2
            subst he2
            exact lowEq_refl G s
          · rw [if_neg hv0] at he2
            simp only [Option.bind_eq_some] at he2
            obtain ⟨s1, he3, he4⟩ := he2
            have hlow1 : lowEq G s s1 := ihbody hsec s s1 he3
            have hty' : TyC G sg (Com.wh e c) (Ty.cmd a b) := TyC.whL hcond hbody hab
            have hlow2 : lowEq G s1 s' := ih (Com.wh e c) (Ty.cmd a b) hty' hsec s1 s' he4
            exact lowEq_trans hlow1 hlow2
      | seqH c d t hc hd ihc ihd =>
          intro hsec s s' he
          simp only [evalC, Option.bind_eq_some] at he
          obtain ⟨s1, he1, he2⟩ := he
          have hlow1 : lowEq G s s1 := ihc hsec s s1 he1
          have hsecd : secure (Ty.cmd Lvl.H Lvl.H) := rfl
          have hlow2 : lowEq G s1 s' := ihd hsecd s1 s' he2
          exact lowEq_trans hlow1 hlow2
      | seqL c d a b hc hd ihc ihd =>
          intro hsec s s' he
          simp only [evalC, Option.bind_eq_some] at he
          obtain ⟨s1, he1, he2⟩ := he
          have hsecc : secure (Ty.cmd a Lvl.L) := hsec
          have hlow1 : lowEq G s s1 := ihc hsecc s s1 he1
          have hlow2 : lowEq G s1 s' := ihd hsec s1 s' he2
          exact lowEq_trans hlow1 hlow2
      | sub t hty0 hsub ihty0 =>
          intro hsec s s' he
          have hsec0 : secure t := secure_sub hsub hsec
          exact ihty0 hsec0 s s' he
