-- PROOF tyE_binop_L
  suffices H : ∀ e t, TyE G sg e t → e = .binop a b → t = .base .L →
      TyE G sg a (.base .L) ∧ TyE G sg b (.base .L) by
    exact H _ _ h rfl rfl
  intro e t h
  induction h with
  | evar _ => intro he ht; cases he
  | int => intro he ht; cases he
  | binop hta htb _ _ =>
      intro he ht
      cases he
      cases ht
      exact ⟨hta, htb⟩
  | call _ _ _ => intro he ht; cases he
  | sub h' hsub ih =>
      intro he ht
      subst ht
      obtain ⟨lv, hlv, hab⟩ := sub_base_inv hsub
      cases lv with
      | L => exact ih he hlv
      | H => exact absurd hab (by decide)
