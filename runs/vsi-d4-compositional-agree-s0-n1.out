-- PROOF agree
  intro k
  induction k with
  | zero =>
    constructor
    · intro e hty s t v w hst hv hw
      simp [evalE] at hv
    · intro c ty hty s t s' t' hst hv hw
      simp [evalC] at hv
  | succ m ih =>
    obtain ⟨ihE, ihC⟩ := ih
    constructor
    · intro e
      cases e with
      | int n =>
        intro _ s t v w hst hv hw
        simp [evalE] at hv hw
        omega
      | evar x =>
        intro hty s t v w hst hv hw
        simp [evalE] at hv hw
        have hgx := tyE_var_L hty
        have heq := hst x hgx
        omega
      | binop a b =>
        intro hty s t v w hst hv hw
        have htya : TyE G sg a (.base .L) := (tyE_binop_L hty).1
        have htyb : TyE G sg b (.base .L) := (tyE_binop_L hty).2
        simp [evalE, Option.bind_eq_some_iff] at hv hw
        obtain ⟨va, hva, vb, hvb, hveq⟩ := hv
        obtain ⟨va', hva', vb', hvb', hweq⟩ := hw
        have e1 := ihE a htya s t va va' hst hva hva'
        have e2 := ihE b htyb s t vb vb' hst hvb hvb'
        omega
      | call f a =>
        intro hty s t v w hst hv hw
        have hsig : sg f = some (.L, .L) := (tyE_call_L hty).1
        have htya : TyE G sg a (.base .L) := (tyE_call_L hty).2
        simp [evalE, Option.bind_eq_some_iff] at hv hw
        obtain ⟨fn, hfn, va, hva, s2, hs2, hveq⟩ := hv
        obtain ⟨fn', hfn', va', hva', t2, ht2, hweq⟩ := hw
        rw [hfn] at hfn'
        injection hfn' with hfeq
        subst hfeq
        have haeq : va = va' := ihE a htya s t va va' hst hva hva'
        subst haeq
        have hsigf := hft.sig f Lvl.L Lvl.L hsig
        obtain ⟨fn2, ty2, hftf2, hparam, hretv, htybody⟩ := hsigf
        rw [hfn] at hftf2
        injection hftf2 with hfeq2
        subst hfeq2
        have hstupd : lowEq G (upd s fn.param va) (upd t fn.param va) := by
          intro y hy
          by_cases hyx : y = fn.param
          · subst hyx; simp [upd]
          · simp [upd, hyx]; exact hst y hy
        have hlow2 : lowEq G s2 t2 :=
          ihC fn.body ty2 htybody (upd s fn.param va) (upd t fn.param va) s2 t2 hstupd hs2 ht2
        have hret : s2 fn.retv = t2 fn.retv := hlow2 fn.retv hretv
        omega
    · intro c ty hty
      induction hty with
      | skip =>
        intro s t s' t' hst hv hw
        simp [evalC] at hv hw
        subst hv
        subst hw
        exact hst
      | @assign x e lv hx hte =>
        intro s t s' t' hst hv hw
        simp [evalC, Option.bind_eq_some_iff] at hv hw
        obtain ⟨ve, hve, hveq⟩ := hv
        obtain ⟨ve', hve', hweq⟩ := hw
        subst hveq
        subst hweq
        intro y hy
        by_cases hyx : y = x
        · subst hyx
          simp [upd]
          cases lv with
          | L => exact ihE e hte s t ve ve' hst hve hve'
          | H =>
            rw [hx] at hy
            injection hy with hy2
            cases hy2
        · simp [upd, hyx]
          exact hst y hy
      | @iteHH e c d hte hc hd ihc ihd =>
        intro s t s' t' hst hv hw
        have confS : lowEq G s s' :=
          confinement (m+1) (.ite e c d) (.cmd .H .H) (TyC.iteHH hte hc hd) (by simp [secure]) s s' hv
        have confT : lowEq G t t' :=
          confinement (m+1) (.ite e c d) (.cmd .H .H) (TyC.iteHH hte hc hd) (by simp [secure]) t t' hw
        exact lowEq_trans (lowEq_trans (lowEq_symm confS) hst) confT
      | @iteL e c d a b hte hc hd ihc ihd =>
        intro s t s' t' hst hv hw
        simp [evalC, Option.bind_eq_some_iff] at hv hw
        obtain ⟨ve, hve, hbr⟩ := hv
        obtain ⟨ve', hve', hbr'⟩ := hw
        have heq : ve = ve' := ihE e hte s t ve ve' hst hve hve'
        subst heq
        by_cases hz : ve = 0
        · simp [hz] at hbr hbr'
          exact ihC d _ hd s t s' t' hst hbr hbr'
        · simp [hz] at hbr hbr'
          exact ihC c _ hc s t s' t' hst hbr hbr'
      | @iteN e c d lv n hte hc hd ihc ihd =>
        intro s t s' t' hst hv hw
        cases lv with
        | L =>
          simp [evalC, Option.bind_eq_some_iff] at hv hw
          obtain ⟨ve, hve, hbr⟩ := hv
          obtain ⟨ve', hve', hbr'⟩ := hw
          have heq : ve = ve' := ihE e hte s t ve ve' hst hve hve'
          subst heq
          by_cases hz : ve = 0
          · simp [hz] at hbr hbr'
            exact ihC d _ hd s t s' t' hst hbr hbr'
          · simp [hz] at hbr hbr'
            exact ihC c _ hc s t s' t' hst hbr hbr'
        | H =>
          have confS : lowEq G s s' :=
            confinement (m+1) (.ite e c d) (.ncmd .H (n+1)) (TyC.iteN hte hc hd) (by simp [secure]) s s' hv
          have confT : lowEq G t t' :=
            confinement (m+1) (.ite e c d) (.ncmd .H (n+1)) (TyC.iteN hte hc hd) (by simp [secure]) t t' hw
          exact lowEq_trans (lowEq_trans (lowEq_symm confS) hst) confT
      | @whHH e c hte hc ihc =>
        intro s t s' t' hst hv hw
        have confS : lowEq G s s' :=
          confinement (m+1) (.wh e c) (.cmd .H .H) (TyC.whHH hte hc) (by simp [secure]) s s' hv
        have confT : lowEq G t t' :=
          confinement (m+1) (.wh e c) (.cmd .H .H) (TyC.whHH hte hc) (by simp [secure]) t t' hw
        exact lowEq_trans (lowEq_trans (lowEq_symm confS) hst) confT
      | @whL e c a b hte hc hle ihc =>
        intro s t s' t' hst hv hw
        simp [evalC, Option.bind_eq_some_iff] at hv hw
        obtain ⟨ve, hve, hbr⟩ := hv
        obtain ⟨ve', hve', hbr'⟩ := hw
        have heq : ve = ve' := ihE e hte s t ve ve' hst hve hve'
        subst heq
        by_cases hz : ve = 0
        · simp [hz] at hbr hbr'
          subst hbr
          subst hbr'
          exact hst
        · simp [hz, Option.bind_eq_some_iff] at hbr hbr'
          obtain ⟨u, hu, hloop⟩ := hbr
          obtain ⟨u', hu', hloop'⟩ := hbr'
          have hlow_uu' : lowEq G u u' := ihC c _ hc s t u u' hst hu hu'
          exact ihC (.wh e c) _ (TyC.whL hte hc hle) u u' s' t' hlow_uu' hloop hloop'
      | @seqH c d lv hc hd ihc ihd =>
        intro s t s' t' hst hv hw
        simp [evalC, Option.bind_eq_some_iff] at hv hw
        obtain ⟨su, hsu, hd1⟩ := hv
        obtain ⟨tu, htu, hd2⟩ := hw
        have confS : lowEq G su s' :=
          confinement m d (.cmd .H .H) hd (by simp [secure]) su s' hd1
        have confT : lowEq G tu t' :=
          confinement m d (.cmd .H .H) hd (by simp [secure]) tu t' hd2
        have hlow_su_tu : lowEq G su tu := ihC c _ hc s t su tu hst hsu htu
        exact lowEq_trans (lowEq_trans (lowEq_symm confS) hlow_su_tu) confT
      | @seqL c d a b hc hd ihc ihd =>
        intro s t s' t' hst hv hw
        simp [evalC, Option.bind_eq_some_iff] at hv hw
        obtain ⟨su, hsu, hd1⟩ := hv
        obtain ⟨tu, htu, hd2⟩ := hw
        have hlow_su_tu : lowEq G su tu := ihC c _ hc s t su tu hst hsu htu
        exact ihC d _ hd su tu s' t' hlow_su_tu hd1 hd2
      | @sub c ty1 ty2 hc hsub ihc =>
        intro s t s' t' hst hv hw
        exact ihc s t s' t' hst hv hw
