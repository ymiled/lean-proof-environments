-- PROOF lem_48f5
  induction c with
  | cusp => intro s t _ h; exact h
  | root x e => intro s t hw h; exact lem_7183 G s t x e hw h
  | flint c d ihc ihd =>
    intro s t hw h
    simp [graft, Bool.and_eq_true] at hw
    exact ihd (hew s c) (hew t c) hw.2 (ihc s t hw.1 h)
  | base e c d ihc ihd =>
    intro s t hw h
    simp [graft, Bool.and_eq_true, Bool.false_or] at hw
    cases h2 : fuse G e with
    | true =>
      rw [h2] at hw
      exact lem_7a2b G e c d s t hw.1 hw.2 h
    | false =>
      rw [h2] at hw
      have heq : weave s e = weave t e := lem_fcb6 G s t e h2 h
      by_cases hz : weave s e = 0
      · have hz' : weave t e = 0 := by rw [← heq]; exact hz
        simp [hew, hz, hz']
        exact ihd s t hw.2 h
      · have hz' : weave t e ≠ 0 := by rw [← heq]; exact hz
        simp [hew, hz, hz']
        exact ihc s t hw.1 h
