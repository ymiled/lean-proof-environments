-- PROOF lowEq_symm
  intro x hx
  exact (h x hx).symm

-- PROOF lowEq_trans
  intro x hx
  exact (h1 x hx).trans (h2 x hx)

-- PROOF Lvl.le_refl
  cases a <;> rfl

-- PROOF Lvl.le_trans
  cases a <;> cases b <;> cases c <;> simp_all [Lvl.le]

-- PROOF lowEq_refl
  intro x _
  rfl

-- PROOF secure_sub
  induction h with
  | refl t => exact hs
  | base hab => exact hs
  | cmd ha hb =>
      simp only [secure] at hs ⊢
      subst hs
      cases a <;> simp_all [Lvl.le]
  | ncmd ha =>
      simp only [secure] at hs ⊢
      subst hs
      cases a <;> simp_all [Lvl.le]
  | ncmdCmd => exact hs
  | funcNcmd => trivial
  | func ha hb => trivial
  | trans _ _ ih1 ih2 => exact ih1 (ih2 hs)

-- PROOF sub_base_inv
  induction h generalizing b with
  | refl t => exact ⟨t, rfl, Lvl.le_refl t⟩
  | base hab => exact ⟨_, rfl, hab⟩
  | trans _ _ ih1 ih2 =>
      obtain ⟨a, ha, hab⟩ := ih2 b rfl
      subst ha
      obtain ⟨a', ha', hab'⟩ := ih1 a rfl
      exact ⟨a', ha', Lvl.le_trans hab' hab⟩

-- PROOF confinement
  intro k
  induction k with
  | zero =>
      intro c ty hty hs s s' he
      simp [evalC] at he
  | succ k ih =>
      intro c ty hty
      induction hty with
      | skip =>
          intro hs s s' he
          simp [evalC] at he
          subst he
          exact lowEq_refl G s
      | assign hxg hte =>
          intro hs s s' he
          simp only [secure] at hs
          simp [evalC] at he
          obtain ⟨v, _, hs'⟩ := he
          subst hs'
          intro y hy
          by_cases hxy : y = x
          · subst hxy; rw [hxg, hs] at hy; exact absurd hy (by decide)
          · simp [upd, hxy]
      | iteHH hte hc hd ihc ihd =>
          intro hs s s' he
          simp [evalC] at he
          obtain ⟨v, _, he'⟩ := he
          by_cases hv : v = 0
          · simp [hv] at he'; exact ihd hs s s' he'
          · simp [hv] at he'; exact ihc hs s s' he'
      | iteL hte hc hd ihc ihd =>
          intro hs s s' he
          simp [evalC] at he
          obtain ⟨v, _, he'⟩ := he
          by_cases hv : v = 0
          · simp [hv] at he'; exact ihd hs s s' he'
          · simp [hv] at he'; exact ihc hs s s' he'
      | iteN hte hc hd ihc ihd =>
          intro hs s s' he
          simp [evalC] at he
          obtain ⟨v, _, he'⟩ := he
          by_cases hv : v = 0
          · simp [hv] at he'; exact ihd hs s s' he'
          · simp [hv] at he'; exact ihc hs s s' he'
      | whHH hte hc ihc =>
          intro hs s s' he
          simp [evalC] at he
          obtain ⟨v, _, he'⟩ := he
          by_cases hv : v = 0
          · simp [hv] at he'; subst he'; exact lowEq_refl G s
          · simp [hv] at he'
            obtain ⟨s1, hc1, hc2⟩ := he'
            have h1 := ihc hs s s1 hc1
            have h2 := ih (.wh e c) (.cmd .H .H) (TyC.whHH hte hc) hs s1 s' hc2
            exact lowEq_trans h1 h2
      | whL hte hc hab ihc =>
          intro hs s s' he
          simp [evalC] at he
          obtain ⟨v, _, he'⟩ := he
          by_cases hv : v = 0
          · simp [hv] at he'; subst he'; exact lowEq_refl G s
          · simp [hv] at he'
            obtain ⟨s1, hc1, hc2⟩ := he'
            have h1 := ihc hs s s1 hc1
            have h2 := ih (.wh e c) (.cmd a b) (TyC.whL hte hc hab) hs s1 s' hc2
            exact lowEq_trans h1 h2
      | seqH hc hd ihc ihd =>
          intro hs s s' he
          simp [evalC] at he
          obtain ⟨s1, hc1, hc2⟩ := he
          have h1 := ihc hs s s1 hc1
          have h2 := ihd rfl s1 s' hc2
          exact lowEq_trans h1 h2
      | seqL hc hd ihc ihd =>
          intro hs s s' he
          simp [evalC] at he
          obtain ⟨s1, hc1, hc2⟩ := he
          have h1 := ihc hs s s1 hc1
          have h2 := ihd hs s1 s' hc2
          exact lowEq_trans h1 h2
      | sub htc hsub ihc =>
          intro hs s s' he
          exact ihc (secure_sub hsub hs) s s' he

-- PROOF tyE_var_L
  have key : ∀ ty, TyE G sg (.evar x) ty → ty = .base .L → G x = .tvar .L := by
    intro ty hty
    induction hty with
    | evar hxg => intro heq; injection heq with heq'; subst heq'; exact hxg
    | sub hte hsub ih =>
        intro heq
        subst heq
        obtain ⟨a, hta, hab⟩ := sub_base_inv hsub
        have haL : a = .L := by cases a <;> simp_all [Lvl.le]
        subst haL
        exact ih hta
  exact key _ h rfl

-- PROOF tyE_binop_L
  have key : ∀ ty, TyE G sg (.binop a b) ty → ty = .base .L →
      TyE G sg a (.base .L) ∧ TyE G sg b (.base .L) := by
    intro ty hty
    induction hty with
    | binop hta htb => intro heq; injection heq with heq'; subst heq'; exact ⟨hta, htb⟩
    | sub hte hsub ih =>
        intro heq
        subst heq
        obtain ⟨a', hta', hab⟩ := sub_base_inv hsub
        have haL : a' = .L := by cases a' <;> simp_all [Lvl.le]
        subst haL
        exact ih hta'
  exact key _ h rfl

-- PROOF tyE_call_L
  have key : ∀ ty, TyE G sg (.call f a) ty → ty = .base .L →
      sg f = some (.L, .L) ∧ TyE G sg a (.base .L) := by
    intro ty hty
    induction hty with
    | call hsg hte => intro heq; injection heq with heq'; subst heq'; exact ⟨hsg, hte⟩
    | sub hte hsub ih =>
        intro heq
        subst heq
        obtain ⟨a', hta', hab⟩ := sub_base_inv hsub
        have haL : a' = .L := by cases a' <;> simp_all [Lvl.le]
        subst haL
        exact ih hta'
  exact key _ h rfl

-- PROOF agree
  intro k
  induction k with
  | zero =>
      refine ⟨?_, ?_⟩
      · intro e he s t v w hlow hv hw; simp [evalE] at hv
      · intro c ty htc s t s' t' hlow hs ht; simp [evalC] at hs
  | succ k ih =>
      obtain ⟨ihE, ihC⟩ := ih
      refine ⟨?_, ?_⟩
      · have keyE : ∀ (ty : Ty) (e : Exp), TyE G sg e ty → ty = .base .L →
            ∀ s t v w, lowEq G s t → evalE ft (k+1) s e = some v →
              evalE ft (k+1) t e = some w → v = w := by
          intro ty e hte
          induction hte with
          | evar hxg =>
              intro heq s t v w hlow hv hw
              injection heq with heq'; subst heq'
              simp [evalE] at hv hw; subst hv; subst hw
              exact hlow _ hxg
          | int =>
              intro heq s t v w hlow hv hw
              simp [evalE] at hv hw; subst hv; subst hw
          | binop hta htb _ _ =>
              intro heq s t v w hlow hv hw
              injection heq with heq'; subst heq'
              simp [evalE] at hv hw
              obtain ⟨va, hva, vb, hvb, hveq⟩ := hv
              obtain ⟨wa, hwa, wb, hwb, hweq⟩ := hw
              have hA := ihE a hta s t va wa hlow hva hwa
              have hB := ihE b htb s t vb wb hlow hvb hwb
              omega
          | call hsg hte' _ =>
              intro heq s t v w hlow hv hw
              injection heq with heq'; subst heq'
              obtain ⟨fn, ty0, hftf0, hgp, hgr, htyb⟩ := hft.sig f .L .L hsg
              simp [evalE, hftf0] at hv hw
              obtain ⟨va, hva, s1, hs1, hv'⟩ := hv
              obtain ⟨wa, hwa, t1, ht1, hw'⟩ := hw
              have hVA : va = wa := ihE a hte' s t va wa hlow hva hwa
              subst hVA
              have hlow' : lowEq G (upd s fn.param va) (upd t fn.param va) := by
                intro y hy
                by_cases hxy : y = fn.param
                · simp [upd, hxy]
                · simp [upd, hxy]; exact hlow y hy
              have hres := ihC fn.body ty0 htyb (upd s fn.param va) (upd t fn.param va)
                s1 t1 hlow' hs1 ht1
              subst hv'; subst hw'
              exact hres fn.retv hgr
          | sub hte hsub ihte =>
              intro heq s t v w hlow hv hw
              subst heq
              obtain ⟨a', hta', hab⟩ := sub_base_inv hsub
              have haL : a' = .L := by cases a' <;> simp_all [Lvl.le]
              subst haL
              exact ihte hta' s t v w hlow hv hw
        intro e he s t v w hlow hv hw
        exact keyE (.base .L) e he rfl s t v w hlow hv hw
      · have keyC : ∀ (ty : Ty) (c : Com), TyC G sg c ty →
            ∀ s t s' t', lowEq G s t → evalC ft (k+1) s c = some s' →
              evalC ft (k+1) t c = some t' → lowEq G s' t' := by
          intro ty c htc
          induction htc with
          | skip =>
              intro s t s' t' hlow hs ht
              simp [evalC] at hs ht
              subst hs; subst ht
              exact hlow
          | assign hxg hte =>
              intro s t s' t' hlow hs ht
              simp [evalC] at hs ht
              obtain ⟨v, hv, hs'⟩ := hs
              obtain ⟨w, hw, ht'⟩ := ht
              have hvw : v = w := ihE e hte s t v w hlow hv hw
              subst hvw
              subst hs'; subst ht'
              intro y hy
              by_cases hxy : y = x
              · subst hxy; simp [upd]
              · simp [upd, hxy]; exact hlow y hy
          | iteHH hte hc hd _ _ =>
              intro s t s' t' hlow hs ht
              simp [evalC] at hs ht
              obtain ⟨v, hv, hs'⟩ := hs
              obtain ⟨w, hw, ht'⟩ := ht
              have hcs : lowEq G s s' := by
                by_cases hv0 : v = 0
                · simp [hv0] at hs'; exact confinement k d (.cmd .H .H) hd rfl s s' hs'
                · simp [hv0] at hs'; exact confinement k c (.cmd .H .H) hc rfl s s' hs'
              have hct : lowEq G t t' := by
                by_cases hw0 : w = 0
                · simp [hw0] at ht'; exact confinement k d (.cmd .H .H) hd rfl t t' ht'
                · simp [hw0] at ht'; exact confinement k c (.cmd .H .H) hc rfl t t' ht'
              exact lowEq_trans (lowEq_trans (lowEq_symm hcs) hlow) hct
          | iteL hte hc hd _ _ =>
              intro s t s' t' hlow hs ht
              simp [evalC] at hs ht
              obtain ⟨v, hv, hs'⟩ := hs
              obtain ⟨w, hw, ht'⟩ := ht
              have hvw : v = w := ihE e hte s t v w hlow hv hw
              subst hvw
              by_cases hv0 : v = 0
              · simp [hv0] at hs' ht'; exact ihC d _ hd s t s' t' hlow hs' ht'
              · simp [hv0] at hs' ht'; exact ihC c _ hc s t s' t' hlow hs' ht'
          | iteN hte hc hd _ _ =>
              intro s t s' t' hlow hs ht
              simp [evalC] at hs ht
              obtain ⟨v, hv, hs'⟩ := hs
              obtain ⟨w, hw, ht'⟩ := ht
              have hvw : v = w := ihE e hte s t v w hlow hv hw
              subst hvw
              by_cases hv0 : v = 0
              · simp [hv0] at hs' ht'; exact ihC d _ hd s t s' t' hlow hs' ht'
              · simp [hv0] at hs' ht'; exact ihC c _ hc s t s' t' hlow hs' ht'
          | whHH hte hc _ =>
              intro s t s' t' hlow hs ht
              simp [evalC] at hs ht
              obtain ⟨v, hv, hs'⟩ := hs
              obtain ⟨w, hw, ht'⟩ := ht
              have hcs : lowEq G s s' := by
                by_cases hv0 : v = 0
                · simp [hv0] at hs'; subst hs'; exact lowEq_refl G s
                · simp [hv0] at hs'
                  obtain ⟨s1, hc1, hc2⟩ := hs'
                  exact lowEq_trans (confinement k c (.cmd .H .H) hc rfl s s1 hc1)
                    (confinement k (.wh e c) (.cmd .H .H) (TyC.whHH hte hc) rfl s1 s' hc2)
              have hct : lowEq G t t' := by
                by_cases hw0 : w = 0
                · simp [hw0] at ht'; subst ht'; exact lowEq_refl G t
                · simp [hw0] at ht'
                  obtain ⟨t1, hc1, hc2⟩ := ht'
                  exact lowEq_trans (confinement k c (.cmd .H .H) hc rfl t t1 hc1)
                    (confinement k (.wh e c) (.cmd .H .H) (TyC.whHH hte hc) rfl t1 t' hc2)
              exact lowEq_trans (lowEq_trans (lowEq_symm hcs) hlow) hct
          | whL hte hc hab _ =>
              intro s t s' t' hlow hs ht
              simp [evalC] at hs ht
              obtain ⟨v, hv, hs'⟩ := hs
              obtain ⟨w, hw, ht'⟩ := ht
              have hvw : v = w := ihE e hte s t v w hlow hv hw
              subst hvw
              by_cases hv0 : v = 0
              · simp [hv0] at hs' ht'; subst hs'; subst ht'; exact hlow
              · simp [hv0] at hs' ht'
                obtain ⟨s1, hc1, hc2⟩ := hs'
                obtain ⟨t1, hc1', hc2'⟩ := ht'
                have h1 := ihC c _ hc s t s1 t1 hlow hc1 hc1'
                exact ihC (.wh e c) _ (TyC.whL hte hc hab) s1 t1 s' t' h1 hc2 hc2'
          | seqH hc hd _ _ =>
              intro s t s' t' hlow hs ht
              simp [evalC] at hs ht
              obtain ⟨s1, hc1, hc2⟩ := hs
              obtain ⟨t1, hc1', hc2'⟩ := ht
              have h1 := ihC c _ hc s t s1 t1 hlow hc1 hc1'
              exact ihC d _ hd s1 t1 s' t' h1 hc2 hc2'
          | seqL hc hd _ _ =>
              intro s t s' t' hlow hs ht
              simp [evalC] at hs ht
              obtain ⟨s1, hc1, hc2⟩ := hs
              obtain ⟨t1, hc1', hc2'⟩ := ht
              have h1 := ihC c _ hc s t s1 t1 hlow hc1 hc1'
              exact ihC d _ hd s1 t1 s' t' h1 hc2 hc2'
          | sub htc hsub ihtc =>
              intro s t s' t' hlow hs ht
              exact ihtc s t s' t' hlow hs ht
        intro c ty htc s t s' t' hlow hs ht
        exact keyC ty c htc s t s' t' hlow hs ht
