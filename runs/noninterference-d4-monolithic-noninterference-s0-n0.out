-- PROOF lem_fcb6
  revert hl
  induction e with
  | stem n => intro _; rfl
  | brim x => intro hl; simp only [fuse] at hl; simp only [weave]; exact h x hl
  | seed a b ih_a ih_b =>
      intro hl
      simp only [fuse] at hl
      simp only [weave]
      have ha : fuse G a = false := by
        cases h1 : fuse G a with
        | false => exact h1
        | true => simp [h1] at hl
      have hb : fuse G b = false := by
        cases h2 : fuse G b with
        | false => exact h2
        | true => simp [h2] at hl
      rw [ih_a ha, ih_b hb]
-- PROOF lem_203f
  simp only [hew]
  split
  · exact hd
  · exact hc
-- PROOF lem_2fc1
  intro x hx
  rfl
-- PROOF lem_aa90
  intro y hy
  simp [graft] at hw
  by_cases hxy : y = x
  · rw [hxy] at hy
    rw [hw] at hy
    simp at hy
  · simp only [clasp, if_neg hxy]
-- PROOF lem_0095
  intro x hx
  rw [h1 x hx, h2 x hx]
-- PROOF lem_cc32
  intro x hx
  exact (h x hx).symm
-- PROOF lem_7183
  intro y hy
  simp only [hew]
  by_cases hxy : y = x
  · simp only [clasp, if_pos hxy]
    have hfe : fuse G e = false := by
      rw [hxy] at hy
      simp only [graft] at hw
      cases hf : fuse G e with
      | false => exact hf
      | true =>
          cases hg : G x with
          | false => rw [hf, hg] at hw; simp at hw
          | true => rw [hg] at hy; simp at hy
    exact lem_fcb6 G s t e hfe h
  · simp only [clasp, if_neg hxy]
    exact h y hy
-- PROOF lem_61d3
  induction c with
  | cusp => intro s _; exact lem_2fc1 G s
  | root x e => intro s hw; exact lem_aa90 G s x e hw
  | flint c d ihc ihd =>
      intro s hw
      have hc' : graft G true c = true := by
        simp only [graft] at hw
        cases h1 : graft G true c with
        | true => exact h1
        | false => simp [h1] at hw
      have hd' : graft G true d = true := by
        simp only [graft] at hw
        cases h2 : graft G true d with
        | true => exact h2
        | false => simp [h2] at hw
      show twine G s (hew (hew s c) d)
      exact lem_0095 G s (hew s c) (hew (hew s c) d) (ihc s hc') (ihd (hew s c) hd')
  | base e c d ihc ihd =>
      intro s hw
      have hc' : graft G true c = true := by
        have hw' : graft G (true || fuse G e) c && graft G (true || fuse G e) d = true := hw
        simp only [Bool.true_or] at hw'
        cases h1 : graft G true c with
        | true => exact h1
        | false => rw [h1] at hw'; simp at hw'
      have hd' : graft G true d = true := by
        have hw' : graft G (true || fuse G e) c && graft G (true || fuse G e) d = true := hw
        simp only [Bool.true_or] at hw'
        cases h2 : graft G true d with
        | true => exact h2
        | false => rw [h2] at hw'; simp at hw'
      exact lem_203f G e c d s (ihc s hc') (ihd s hd')
-- PROOF lem_7a2b
  have Hsc : twine G s (hew s c) := lem_61d3 G c s hc
  have Hsd : twine G s (hew s d) := lem_61d3 G d s hd
  have Htc : twine G t (hew t c) := lem_61d3 G c t hc
  have Htd : twine G t (hew t d) := lem_61d3 G d t hd
  have CC : twine G (hew s c) (hew t c) :=
    lem_0095 G (hew s c) s (hew t c) (lem_cc32 G s (hew s c) Hsc) (lem_0095 G s t (hew t c) h Htc)
  have CD : twine G (hew s c) (hew t d) :=
    lem_0095 G (hew s c) s (hew t d) (lem_cc32 G s (hew s c) Hsc) (lem_0095 G s t (hew t d) h Htd)
  have DC : twine G (hew s d) (hew t c) :=
    lem_0095 G (hew s d) s (hew t c) (lem_cc32 G s (hew s d) Hsd) (lem_0095 G s t (hew t c) h Htc)
  have DD : twine G (hew s d) (hew t d) :=
    lem_0095 G (hew s d) s (hew t d) (lem_cc32 G s (hew s d) Hsd) (lem_0095 G s t (hew t d) h Htd)
  show twine G (if weave s e = 0 then hew s d else hew s c) (if weave t e = 0 then hew t d else hew t c)
  by_cases h1 : weave s e = 0
  · by_cases h2 : weave t e = 0
    · rw [if_pos h1, if_pos h2]; exact DD
    · rw [if_pos h1, if_neg h2]; exact DC
  · by_cases h2 : weave t e = 0
    · rw [if_neg h1, if_pos h2]; exact CD
    · rw [if_neg h1, if_neg h2]; exact CC
-- PROOF lem_48f5
  induction c with
  | cusp => intro s t _ h; exact h
  | root x e => intro s t hw h; exact lem_7183 G s t x e hw h
  | flint c d ihc ihd =>
      intro s t hw h
      have hc' : graft G false c = true := by
        simp only [graft] at hw
        cases h1 : graft G false c with
        | true => exact h1
        | false => simp [h1] at hw
      have hd' : graft G false d = true := by
        simp only [graft] at hw
        cases h2 : graft G false d with
        | true => exact h2
        | false => simp [h2] at hw
      show twine G (hew (hew s c) d) (hew (hew t c) d)
      exact ihd (hew s c) (hew t c) hd' (ihc s t hc' h)
  | base e c d ihc ihd =>
      intro s t hw h
      cases hfe : fuse G e with
      | true =>
          have hct : graft G true c = true := by
            have hw' : graft G (false || fuse G e) c && graft G (false || fuse G e) d = true := hw
            rw [hfe] at hw'
            simp only [Bool.false_or] at hw'
            cases h1 : graft G true c with
            | true => exact h1
            | false => rw [h1] at hw'; simp at hw'
          have hdt : graft G true d = true := by
            have hw' : graft G (false || fuse G e) c && graft G (false || fuse G e) d = true := hw
            rw [hfe] at hw'
            simp only [Bool.false_or] at hw'
            cases h2 : graft G true d with
            | true => exact h2
            | false => rw [h2] at hw'; simp at hw'
          show twine G (if weave s e = 0 then hew s d else hew s c) (if weave t e = 0 then hew t d else hew t c)
          exact lem_7a2b G e c d s t hct hdt h
      | false =>
          have hc' : graft G false c = true := by
            have hw' : graft G (false || fuse G e) c && graft G (false || fuse G e) d = true := hw
            rw [hfe] at hw'
            simp only [Bool.false_or] at hw'
            cases h1 : graft G false c with
            | true => exact h1
            | false => rw [h1] at hw'; simp at hw'
          have hd' : graft G false d = true := by
            have hw' : graft G (false || fuse G e) c && graft G (false || fuse G e) d = true := hw
            rw [hfe] at hw'
            simp only [Bool.false_or] at hw'
            cases h2 : graft G false d with
            | true => exact h2
            | false => rw [h2] at hw'; simp at hw'
          have hwe : weave s e = weave t e := lem_fcb6 G s t e hfe h
          show twine G (if weave s e = 0 then hew s d else hew s c) (if weave t e = 0 then hew t d else hew t c)
          rw [hwe]
          by_cases hcond : weave t e = 0
          · rw [if_pos hcond, if_pos hcond]
            exact ihd s t hd' h
          · rw [if_neg hcond, if_neg hcond]
            exact ihc s t hc' h
