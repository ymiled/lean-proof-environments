-- PROOF secure_sub
  revert hs
  induction h with
  | refl t => intro hs; exact hs
  | base hab => intro hs; exact hs
  | cmd ha hb =>
      intro hs
      simp [secure] at hs ⊢
      subst hs
      cases a <;> simp_all [Lvl.le]
  | ncmd ha =>
      intro hs
      simp [secure] at hs ⊢
      subst hs
      cases a <;> simp_all [Lvl.le]
  | ncmdCmd => intro hs; exact hs
  | funcNcmd => intro _; simp [secure]
  | func ha hb => intro _; simp [secure]
  | trans h1 h2 ih1 ih2 => intro hs; exact ih1 (ih2 hs)
