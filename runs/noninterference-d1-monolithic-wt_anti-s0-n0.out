-- PROOF lem_a681
  induction c with
  | cusp => intro _; rfl
  | root x e =>
      intro hw
      have hgx : G x = true := by
        simp only [graft] at hw
        cases h1 : G x with
        | true => exact h1
        | false => simp [h1] at hw
      show (!(fuse G e || false) || G x) = true
      rw [hgx]
      simp only [Bool.or_true]
  | flint c d ihc ihd =>
      intro hw
      have hct : graft G true c = true := by
        simp only [graft] at hw
        cases h1 : graft G true c with
        | true => exact h1
        | false => simp [h1] at hw
      have hdt : graft G true d = true := by
        simp only [graft] at hw
        cases h2 : graft G true d with
        | true => exact h2
        | false => simp [h2] at hw
      have hc' : graft G false c = true := ihc hct
      have hd' : graft G false d = true := ihd hdt
      show graft G false c && graft G false d = true
      rw [hc', hd']
  | base e c d ihc ihd =>
      intro hw
      have hct : graft G true c = true := by
        have hw' : graft G (true || fuse G e) c && graft G (true || fuse G e) d = true := hw
        simp only [Bool.true_or] at hw'
        cases h1 : graft G true c with
        | true => exact h1
        | false => rw [h1] at hw'; simp at hw'
      have hdt : graft G true d = true := by
        have hw' : graft G (true || fuse G e) c && graft G (true || fuse G e) d = true := hw
        simp only [Bool.true_or] at hw'
        cases h2 : graft G true d with
        | true => exact h2
        | false => rw [h2] at hw'; simp at hw'
      cases hfe : fuse G e with
      | true =>
          show graft G (false || fuse G e) c && graft G (false || fuse G e) d = true
          rw [hfe]
          simp only [Bool.false_or]
          rw [hct, hdt]
      | false =>
          have hc' : graft G false c = true := ihc hct
          have hd' : graft G false d = true := ihd hdt
          show graft G (false || fuse G e) c && graft G (false || fuse G e) d = true
          rw [hfe]
          simp only [Bool.false_or]
          rw [hc', hd']
