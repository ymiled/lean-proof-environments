-- PROOF tyE_call_L
  suffices H : ∀ e t, TyE G sg e t → e = .call f a → t = .base .L →
      sg f = some (.L, .L) ∧ TyE G sg a (.base .L) by
    exact H _ _ h rfl rfl
  intro e t h
  induction h with
  | evar _ => intro he ht; cases he
  | int => intro he ht; cases he
  | binop _ _ _ _ => intro he ht; cases he
  | call hsg hty _ =>
      intro he ht
      cases he
      cases ht
      exact ⟨hsg, hty⟩
  | sub h' hsub ih =>
      intro he ht
      subst ht
      obtain ⟨lv, hlv, hab⟩ := sub_base_inv hsub
      cases lv with
      | L => exact ih he hlv
      | H => exact absurd hab (by decide)
