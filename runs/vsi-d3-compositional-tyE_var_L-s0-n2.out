-- PROOF tyE_var_L
  suffices H : ∀ e t, TyE G sg e t → e = .evar x → t = .base .L → G x = .tvar .L by
    exact H _ _ h rfl rfl
  intro e t h
  induction h with
  | evar hx => intro he ht; cases he; cases ht; exact hx
  | int => intro he ht; cases he
  | binop _ _ _ _ => intro he ht; cases he
  | call _ _ _ => intro he ht; cases he
  | sub h' hsub ih =>
      intro he ht
      subst ht
      obtain ⟨lv, hlv, hab⟩ := sub_base_inv hsub
      cases lv with
      | L => exact ih he hlv
      | H => exact absurd hab (by decide)
