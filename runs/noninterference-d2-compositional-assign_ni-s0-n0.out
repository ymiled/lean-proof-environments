-- PROOF lem_7183
  intro y hy
  simp only [hew]
  by_cases hxy : y = x
  · subst hxy
    have hfuse : fuse G e = false := by
      by_contra hne
      have hft : fuse G e = true := by
        cases hfe : fuse G e with
        | false => exact absurd hfe hne
        | true => rfl
      simp [graft, hft, hy] at hw
    have heq : weave s e = weave t e := lem_fcb6 G s t e hfuse h
    simp [clasp, heq]
  · simpa [clasp, hxy] using h y hy
