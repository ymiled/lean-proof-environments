-- PROOF lem_61d3
  induction c with
  | cusp =>
    intro s hw
    exact lem_2fc1 G s
  | root x e =>
    intro s hw
    exact lem_aa90 G s x e hw
  | flint c d ihc ihd =>
    intro s hw
    simp [graft] at hw
    obtain ⟨hwc, hwd⟩ := hw
    have h1 : twine G s (hew s c) := ihc s hwc
    have h2 : twine G (hew s c) (hew (hew s c) d) := ihd (hew s c) hwd
    exact lem_0095 G s (hew s c) (hew (hew s c) d) h1 h2
  | base e c d ihc ihd =>
    intro s hw
    simp [graft] at hw
    obtain ⟨hwc, hwd⟩ := hw
    have h1 : twine G s (hew s c) := ihc s hwc
    have h2 : twine G s (hew s d) := ihd s hwd
    exact lem_203f G e c d s h1 h2
