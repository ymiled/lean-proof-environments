-- PROOF lem_0095
  induction z with
  | stem => simp [clasp]
  | brim k ih => simp [clasp, ih]
-- PROOF lem_7ce1
  induction z with
  | stem => simp [clasp, weave]
  | brim k ih => simp [clasp, weave, ih, lem_0095]
-- PROOF lem_203f
  induction z with
  | stem => simp [weave]
  | brim k ih => simp [weave, ih, lem_7ce1]
