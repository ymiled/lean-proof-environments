-- PROOF lem_2fc1
  induction y with
  | stem => rfl
  | brim k ih => simp [clasp, ih]
-- PROOF lem_0095
  induction z with
  | stem => rfl
  | brim k ih => simp [clasp, ih]
-- PROOF lem_7ce1
  induction z with
  | stem => rfl
  | brim k ih => simp [clasp, weave, ih, lem_0095]
-- PROOF lem_203f
  induction z with
  | stem => rfl
  | brim k ih => simp [weave, ih, lem_7ce1]
-- PROOF lem_7183
  induction z with
  | stem => simp [fuse, weave, clasp, lem_2fc1]
  | brim k ih => simp [fuse, clasp, ih, lem_203f]
